# 复制成 cloud/.env 后填值；不填就用 --stt canned --tts silent 跑通链路
# 阿里云实时识别（STT）
ALIYUN_AK_ID=
ALIYUN_AK_SECRET=
ALIYUN_APPKEY=
ALIYUN_NLS_REGION=cn-shanghai
# MiMo TTS
MIMO_API_KEY=
MIMO_TTS_VOICE=
# agent 可执行文件（Windows 指 npm shim；不填就用 PATH 里的 dsh）
# DSH_BIN=%APPDATA%\npm\dsh.cmd
# 设备鉴权（每行 token 或 token:deviceId）
# MIAI_TOKENS=./tokens.txt
